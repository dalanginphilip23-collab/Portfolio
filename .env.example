GEMINI_API_KEY=your_gemini_api_key_here
# Get your key at https://aistudio.google.com/app/apikey
# 1. Copy this file to .env.local
# 2. Replace with your real key
# 3. Restart: npm run dev
# NEVER commit .env.local — it's gitignored

# Optional: restrict key in Google Cloud Console to your domain

# Optional contact form backend (Formspree). If empty, form falls back to mailto:.
# Get ID at https://formspree.io — then set VITE_FORMSPREE_ID=xxxxxx in .env.local
VITE_FORMSPREE_ID=
